<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Une petite surprise 💌</title>

  <style>
    :root{
      --bg1:#ffe7f1;
      --bg2:#ffffff;
      --card: rgba(255,255,255,.72);
      --shadow: 0 22px 60px rgba(0,0,0,.13);
      --pink:#ff4da6;
      --pink2:#ff7ac1;
      --text:#222;
      --muted:#666;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      min-height:100vh;
      display:grid;
      place-items:center;
      background: radial-gradient(circle at top, var(--bg1), var(--bg2));
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color:var(--text);
      overflow:hidden;
    }

    .wrap{
      width:min(980px, 92vw);
      background: var(--card);
      border: 1px solid rgba(255,77,166,.22);
      border-radius: 28px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(10px);
      padding: clamp(16px, 3.5vw, 28px);
    }

    .row{
      display:flex;
      gap: clamp(14px, 3.5vw, 28px);
      align-items:center;
      justify-content:center;
      flex-wrap:wrap;
      min-height: 320px;
    }

    .hint{ max-width: 460px; }
    .hint h1{
      margin:0 0 10px 0;
      font-size: clamp(22px, 3.5vw, 34px);
      letter-spacing: .2px;
    }
    .hint p{
      margin:0;
      font-size: clamp(16px, 2.6vw, 20px);
      color:var(--muted);
      line-height:1.45;
    }
    .counter{
      margin-top: 10px;
      font-size: 14px;
      color:#777;
    }

    /* Envelope button */
    .env-btn{
      appearance:none;
      border:none;
      background:transparent;
      padding:0;
      cursor:pointer;
      outline:none;
      position:relative;
      width: 220px;
      height: 160px;
      display:grid;
      place-items:center;
      transform: translateY(6px);
      animation: float 2.3s ease-in-out infinite;
      filter: drop-shadow(0 18px 25px rgba(0,0,0,.16));
    }
    .env-btn:active{ transform: translateY(8px) scale(.99); }
    @keyframes float{
      0%,100%{ transform: translateY(6px); }
      50%{ transform: translateY(-2px); }
    }

    /* Envelope drawing */
    .envelope{
      width: 210px;
      height: 140px;
      position:relative;
    }
    .env-body{
      position:absolute;
      left:0; right:0;
      bottom:0;
      height: 100px;
      background: linear-gradient(135deg, #fff, #ffe3f0);
      border: 2px solid rgba(255,77,166,.35);
      border-radius: 18px;
      overflow:hidden;
    }
    .env-body:before, .env-body:after{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(135deg, transparent 48%, rgba(255,77,166,.25) 49%, rgba(255,77,166,.25) 51%, transparent 52%),
        linear-gradient(225deg, transparent 48%, rgba(255,77,166,.18) 49%, rgba(255,77,166,.18) 51%, transparent 52%);
      opacity:.55;
      pointer-events:none;
    }

    /* flap */
    .flap{
      position:absolute;
      left:0; right:0;
      top: 38px;
      margin:auto;
      width: 0;
      height: 0;
      border-left: 105px solid transparent;
      border-right: 105px solid transparent;
      border-top: 70px solid rgba(255,77,166,.25);
      transform-origin: top center;
      transform: rotateX(0deg);
      transition: transform 600ms ease;
    }
    .flap::after{
      content:"";
      position:absolute;
      left:-105px;
      top:-70px;
      width:0;height:0;
      border-left:105px solid transparent;
      border-right:105px solid transparent;
      border-top:70px solid rgba(255,255,255,.75);
      filter: blur(.2px);
      opacity:.9;
    }

    /* Heart seal */
    .seal{
      position:absolute;
      left:50%;
      bottom: 26px;
      transform: translateX(-50%);
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background: radial-gradient(circle at 30% 30%, #fff, #ffd1e6);
      border: 2px solid rgba(255,77,166,.35);
      display:grid;
      place-items:center;
      animation: pulse 1.25s ease-in-out infinite;
    }
    .seal span{ font-size: 22px; transform: translateY(1px); }

    @keyframes pulse{
      0%,100%{ transform: translateX(-50%) scale(1); }
      50%{ transform: translateX(-50%) scale(1.08); }
    }

    /* click feedback */
    .pop{ animation: pop 340ms ease; }
    @keyframes pop{
      0%{ transform: scale(1); }
      55%{ transform: scale(1.05); }
      100%{ transform: scale(1); }
    }

    /* Confetti hearts */
    .heart{
      position:fixed;
      top:-40px;
      font-size: 22px;
      opacity:.9;
      pointer-events:none;
      user-select:none;
      filter: drop-shadow(0 10px 14px rgba(0,0,0,.12));
      animation: fall linear forwards;
    }
    @keyframes fall{
      to{ transform: translateY(115vh) rotate(360deg); opacity:0; }
    }

    /* Final (music) */
    .final{
      display:none;
      margin-top: 18px;
      padding: 18px 16px;
      border-radius: 20px;
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(255,77,166,.25);
    }
    .final h2{
      margin:0 0 8px 0;
      font-size: clamp(20px, 3vw, 28px);
    }
    .final p{
      margin:0 0 14px 0;
      color:var(--muted);
      line-height:1.45;
    }
    .player{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }
    .btn{
      border:none;
      padding: 12px 14px;
      border-radius: 14px;
      background: var(--pink);
      color:white;
      cursor:pointer;
      box-shadow: 0 14px 30px rgba(255,77,166,.28);
      transition: transform 120ms ease, opacity 120ms ease;
      font-size: 14px;
    }
    .btn:hover{ transform: translateY(-1px); }
    .btn:active{ transform: translateY(1px); opacity:.92; }
    .small{ font-size: 13px; color:#777; }

    /* Open state */
    .open .flap{ transform: rotateX(155deg); }
    .open .seal{ animation: none; }

    /* Gift section */
    .giftWrap{
      display:none;
      margin-top: 14px;
      padding: 16px;
      border-radius: 20px;
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(255,77,166,.25);
    }

    .giftRow{
      display:flex;
      align-items:center;
      gap:16px;
      flex-wrap:wrap;
    }

    .giftHint{
      font-size: 18px;
      color: var(--muted);
    }
    .giftHint strong{ color: var(--text); }

    .giftBtn{
      border:none;
      background:transparent;
      cursor:pointer;
      padding:0;
      width: 180px;
      height: 160px;
      filter: drop-shadow(0 18px 25px rgba(0,0,0,.16));
    }

    .gift{
      width: 180px;
      height: 160px;
      position:relative;
      display:grid;
      place-items:center;
      animation: floatGift 2.2s ease-in-out infinite;
    }

    @keyframes floatGift{
      0%,100%{ transform: translateY(6px); }
      50%{ transform: translateY(-2px); }
    }

    .boxBase{
      position:absolute;
      bottom: 0;
      width: 160px;
      height: 92px;
      border-radius: 18px;
      border: 2px solid rgba(255,77,166,.35);
      background: linear-gradient(135deg, #fff, #ffe3f0);
      overflow:hidden;
    }
    .boxBase:before{
      content:"";
      position:absolute;
      left:50%;
      top:0;
      transform: translateX(-50%);
      width: 26px;
      height: 100%;
      background: linear-gradient(180deg, rgba(255,77,166,.55), rgba(255,122,193,.45));
      opacity:.9;
    }

    .lid{
      position:absolute;
      bottom: 84px;
      width: 170px;
      height: 44px;
      border-radius: 18px;
      border: 2px solid rgba(255,77,166,.35);
      background: linear-gradient(135deg, #fff, #ffd6ea);
      transform-origin: left bottom;
      transform: rotate(0deg);
      transition: transform 700ms cubic-bezier(.2,.9,.2,1);
    }
    .lid:before{
      content:"";
      position:absolute;
      left:50%;
      top:0;
      transform: translateX(-50%);
      width: 26px;
      height: 100%;
      background: linear-gradient(180deg, rgba(255,77,166,.55), rgba(255,122,193,.45));
      opacity:.9;
      border-radius: 12px;
    }

    .bow{
      position:absolute;
      bottom: 110px;
      font-size: 26px;
      animation: bowPulse 1.2s ease-in-out infinite;
    }
    @keyframes bowPulse{
      0%,100%{ transform: scale(1); }
      50%{ transform: scale(1.08); }
    }

    .giftOpen .lid{ transform: rotate(-75deg); }
    .giftOpen .bow{ animation:none; }

    .letter{
      display:none;
      margin-top: 14px;
      padding: 16px;
      border-radius: 18px;
      background: rgba(255,255,255,.78);
      border: 1px solid rgba(255,77,166,.25);
      max-height: 46vh;
      overflow:auto;
      line-height:1.55;
      color:#222;
      white-space: pre-wrap;
    }

    .sr{
      position:absolute;
      width:1px;height:1px;
      padding:0;margin:-1px;
      overflow:hidden;clip:rect(0,0,0,0);
      white-space:nowrap;border:0;
    }
  </style>
</head>

<body>
  <div class="wrap">
    <div class="row">
      <button class="env-btn" id="envBtn" aria-label="Enveloppe à cliquer">
        <div class="envelope" id="envelope">
          <div class="flap"></div>
          <div class="env-body"></div>
          <div class="seal"><span>❤️</span></div>
        </div>
        <span class="sr" id="srStatus"></span>
      </button>

      <div class="hint">
        <h1 id="title">Coucou 👀</h1>
        <p id="instruction">Clique sur l'enveloppe</p>
        <div class="counter" id="counter"></div>

        <div class="final" id="finalBox">
          <h2>Bravo, tu as de la patience. Maintenant écoute ça 🎶</h2>
          <p>Appuie sur “Jouer”. (Si ton navigateur bloque le son, reclique sur “Jouer”.)</p>

          <div class="player">
            <button class="btn" id="playBtn">▶
